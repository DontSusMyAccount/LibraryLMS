# ============================================================================
# Library LMS — Environment Variables (ตัวอย่าง)
# สร้างไฟล์ .env จากไฟล์นี้ แล้วเติมค่าจริง — ห้าม commit .env*
# ============================================================================

# --- Backend (Elysia) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/library_lms
PORT=3001

# --- Auth ---
# AUTH_SECRET: min 32 chars (NextAuth) — สร้างได้ด้วย: bunx auth secret
AUTH_SECRET=
# JWT_SECRET: optional — ใช้ sign/verify Bearer tokens สำหรับ direct/mobile API access
# ถ้าไม่ตั้งจะ fallback ใช้ AUTH_SECRET (web ใช้ proxy headers ผ่าน INTERNAL_SECRET)
JWT_SECRET=
# INTERNAL_SECRET: min 16 chars — ใช้ยืนยัน proxy headers ระหว่าง Next.js → Elysia
INTERNAL_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Cloudflare R2 (รูปปกหนังสือ) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=library-covers
# custom domain ของ bucket (ถ้ามี) เช่น https://covers.libsys.ac.th
R2_PUBLIC_URL=
